# =============================================================================
# Conecta AI Gateway — variables de entorno
# =============================================================================
# Copiar a .env y completar. NUNCA commitear el .env real.

# --- HMAC secrets (mismos valores que en Ajustes > AI Diagnosis de Odoo) ---
WEBHOOK_SECRET=change-me-please-32+chars-random
CALLBACK_SECRET=change-me-also-32+chars-random
TIMESTAMP_TOLERANCE=300

# --- Copilot CLI ---
# El binario `copilot` (paquete @github/copilot) se instala en la imagen.
COPILOT_BIN=copilot
COPILOT_MODEL=claude-sonnet-4.5
# Token opcional. Preferí volumen ~/.copilot ya autenticado con `copilot auth login`.
# COPILOT_TOKEN=
# Args extra (separados por espacio). NO añadas --allow-all-tools en V1.
# COPILOT_EXTRA_ARGS=
COPILOT_TIMEOUT_SECONDS=600
COPILOT_WORKDIR=/tmp/copilot-runs

# --- SSH ---
SSH_KEYS_DIR=/home/gateway/.ssh
SSH_DEFAULT_KEY_NAME=id_rsa_conecta

# --- Odoo callback ---
ODOO_REQUEST_TIMEOUT=30

# --- Odoo XMLRPC (para endpoints internos /support-clients consumidos por Hermes) ---
ODOO_URL=https://odoo.conecta.sh
ODOO_DB=Conecta
ODOO_LOGIN=hermes
ODOO_PASSWORD=change-me

# --- API Token Bearer consumido por Hermes ---
HERMES_API_TOKEN=change-me-please-32+chars-random

# --- Logs ---
LOG_LEVEL=info
