<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Comentario en español: agrega el proyecto por defecto de helpdesk en la ficha del contacto -->
    <record id="view_partner_form_helpdesk_project" model="ir.ui.view">
        <field name="name">res.partner.form.helpdesk.project</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sales_purchases']//group[@name='sale']" position="inside">
                <field name="helpdesk_project_id" options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>
</odoo>
