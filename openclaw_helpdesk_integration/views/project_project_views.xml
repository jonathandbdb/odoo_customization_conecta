<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Nueva pestaña en la ficha del proyecto con los datos del cliente -->
    <record id="view_project_project_form_openclaw" model="ir.ui.view">
        <field name="name">project.project.form.openclaw</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='settings']" position="after">
                <page name="openclaw_client_connection" string="Client Connection (IA)"
                      groups="openclaw_helpdesk_integration.group_openclaw_connection_manager">
                    <group>
                        <group string="SSH">
                            <field name="client_ssh_host" placeholder="e.g. 192.168.1.10"/>
                            <field name="client_ssh_port"/>
                            <field name="client_ssh_user"/>
                            <field name="ai_diagnosis_enabled"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="client_ssh_notes" nolabel="1"
                               placeholder="Stack, log paths, Odoo version, any hint the AI agent needs..."/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
